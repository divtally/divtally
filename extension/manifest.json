{
  "manifest_version": 3,
  "name": "DivTally Browser Extension",
  "version": "1.1.0",
  "description": "Prices rares/uniques for DivTally using YOUR browser + YOUR IP, so the public website never hits GGG's trade rate limits or risks a ban. Not affiliated with Grinding Gear Games.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.pathofexile.com/api/trade/*"],
  "browser_specific_settings": { "gecko": { "id": "extension@divtally.com" } },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DivTally",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://divtally.com/*", "https://www.divtally.com/*", "https://divtally.pages.dev/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
